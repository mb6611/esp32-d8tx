{
  // Static deploy of the d8tx controller to Cloudflare Workers (assets only, no Worker script).
  // Build first: pnpm --filter web build. Deploy: pnpm --filter web run deploy.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "d8tx",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
