+static void sendStatus(void)
+{
+    uint16_t st = 0;
+    if (ARMING_FLAG(ARMED)) st |= 1 << 0;
+    if (FLIGHT_MODE(ANGLE_MODE)) st |= 1 << 1;
+    if (FLIGHT_MODE(HORIZON_MODE)) st |= 1 << 2;
+    if (FLIGHT_MODE(FAILSAFE_MODE)) st |= 1 << 3;
+    if (isArmingDisabled()) st |= 1 << 4;
+    if (!FLIGHT_MODE(ANGLE_MODE | HORIZON_MODE)) st |= 1 << 5;
+    frSkyHubWriteFrame(ID_STATUS, (int16_t)st);
+    frSkyHubWriteFrame(ID_ARMING_DISABLE, (int16_t)(getArmingDisableFlags() & 0xFFFF));
+}
+
+static void sendGyro(void)
+{
+    for (unsigned i = 0; i < 3; i++) {
+        // 0.1 deg/s units
+        frSkyHubWriteFrame(ID_GYRO_X + i, clampToInt16(lrintf(gyro.gyroADCf[i] * 10.0f)));
+    }
+}
+
+static void sendAttitude(void)
+{
+    for (unsigned i = 0; i < 3; i++) {
+        frSkyHubWriteFrame(ID_ATT_ROLL + i, (int16_t)attitude.raw[i]);
+    }
+}
